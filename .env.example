# Public production URL used for metadata/canonical generation.
NEXT_PUBLIC_SITE_URL=https://aiskillab.work

# Public contact links.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/BiTFormer
NEXT_PUBLIC_WHATSAPP_URL=

# Optional Next-runtime lead-form details. The committed static public release does not read this file.
# Keep blank unless explicitly testing a separate NEXT_PUBLIC_LEAD_FORM_ENABLED=true runtime.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=

# Private receiver/signing configuration belongs only to services/lead-ingress/.env.example.
# Do not set LEAD_WEBHOOK_URL or LEAD_WEBHOOK_SECRET on the public static project.

# This flag is not public static-release authority.
NEXT_PUBLIC_LEAD_FORM_ENABLED=false
