# Server-only activation switch. Keep false until the activation gate is complete.
LEAD_INGRESS_ENABLED=false

# Comma-separated HTTPS browser origins allowed to reach the ingress through the public same-origin rewrite.
LEAD_ALLOWED_ORIGINS=https://aiskillab.work

# Private HTTPS downstream receiver controlled by the owner.
LEAD_WEBHOOK_URL=

# Mandatory HMAC-SHA256 secret. Use at least 32 UTF-8 bytes.
LEAD_WEBHOOK_SECRET=

# Production-blocking legal/privacy facts. Do not infer these values.
LEAD_LEGAL_OPERATOR_NAME=
LEAD_LEGAL_JURISDICTION=
LEAD_PRIVACY_CONTACT=robert@aiskillab.work

# Frozen lead-intake retention policy for unconverted submissions.
LEAD_RETENTION_DAYS=30

# Set true only after provider-level rate limiting has been configured and independently verified.
LEAD_RATE_LIMIT_READY=false

# F1.2 route service stays fail-closed until the exact central rate gate is deployed and verified.
ROUTE_API_ENABLED=false
ROUTE_ALLOWED_ORIGINS=https://aiskillab.work
ROUTE_RATE_LIMIT_READY=false
ROUTE_DAILY_LIMIT_READY=false
ROUTE_PRIVACY_READY=false
# Intentionally blank: Robert must explicitly approve the site-wide rolling-24h limit before activation.
ROUTE_DAILY_LIMIT=

# Verified account-level daily request budget for the selected :free OpenRouter account.
# Intentionally blank until the account quota is checked. Activation also requires
# ROUTE_DAILY_LIMIT * 3 <= OPENROUTER_DAILY_REQUEST_BUDGET.
OPENROUTER_DAILY_REQUEST_BUDGET=

# Server-only OpenRouter primary configuration. Never expose keys to browser code or logs.
OPENROUTER_API_KEY=
# Comma-separated free OpenRouter models only; each entry must end in :free.
OPENROUTER_MODELS=

# Optional second funded OpenRouter account for credential-auth failover only.
# Keep false unless separately approved and independently quota-verified.
# When enabled, activation requires a distinct backup key and also requires
# ROUTE_DAILY_LIMIT * 3 <= OPENROUTER_BACKUP_DAILY_REQUEST_BUDGET.
# Runtime may switch primary -> backup only on primary 401. It must NOT
# switch accounts on 402/403/429, so backup cannot bypass payment, policy or quota limits.
OPENROUTER_BACKUP_ENABLED=false
OPENROUTER_BACKUP_DAILY_REQUEST_BUDGET=
OPENROUTER_BACKUP_API_KEY=

# F1.5 Telegram FAQ bot. Keep disabled until a separate BotFather token,
# webhook secret, webhook registration and production activation are approved.
TELEGRAM_FAQ_ENABLED=false
TELEGRAM_FAQ_BOT_TOKEN=
TELEGRAM_FAQ_WEBHOOK_SECRET=
