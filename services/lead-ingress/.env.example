# Server-only activation switch. Keep false until the activation gate is complete.
LEAD_INGRESS_ENABLED=false

# Comma-separated HTTPS browser origins allowed to reach the ingress through the public same-origin rewrite.
LEAD_ALLOWED_ORIGINS=https://aiskillab.work

# Private HTTPS downstream receiver controlled by the owner.
LEAD_WEBHOOK_URL=

# Mandatory HMAC-SHA256 secret. Use at least 32 UTF-8 bytes.
LEAD_WEBHOOK_SECRET=

# Production-blocking legal/privacy facts. Do not infer these values.
LEAD_LEGAL_OPERATOR_NAME=
LEAD_LEGAL_JURISDICTION=
LEAD_PRIVACY_CONTACT=robert@aiskillab.work

# Frozen lead-intake retention policy for unconverted submissions.
LEAD_RETENTION_DAYS=30

# Set true only after provider-level rate limiting has been configured and independently verified.
LEAD_RATE_LIMIT_READY=false
