{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-skill-lab-lead-receiver",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": false
    },
    "redact_query_string": true
  },
  "vars": {
    "LEAD_RECEIVER_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1535251417",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-skill-lab-leads-r101b",
      "database_id": "1de9ec7f-5d92-4edd-a069-ec5296b54b82"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
