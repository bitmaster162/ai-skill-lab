+*{box-sizing:border-box;min-width:0}body{margin:0;background:#070a12;color:#eef2f6;font:1rem/1.55 system-ui,sans-serif}header,main{max-width:1000px;margin:auto;padding:20px clamp(16px,4vw,32px)}header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}a{color:#8ef5df;text-decoration:underline;overflow-wrap:anywhere}h1,h2,h3{line-height:1.2;overflow-wrap:anywhere}h1{font-size:clamp(1.85rem,5vw,3rem)}p{overflow-wrap:anywhere}.muted{color:#b4bfce}.skip-link{position:fixed;left:-10000px;top:12px;background:#b9ff3f;color:#070a12;padding:12px;z-index:1000;max-width:calc(100% - 24px)}.skip-link:focus{left:12px}:is(a,select,button,textarea,main):focus-visible{outline:3px solid #b9ff3f;outline-offset:3px}fieldset{border:0;padding:0;margin:24px 0;min-width:0}legend{font-size:1.5rem;font-weight:700;margin-bottom:12px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px}.item,.plan{padding:18px;border:1px solid #526079;background:#0d1320;border-radius:16px}.item{display:flex;flex-direction:column;gap:10px}.item h3,.item p{margin:0}.item select{margin-top:auto;width:100%;font:inherit;padding:10px;border-radius:8px;border:1px solid #8192aa;background:#152338;color:#eef2f6;min-height:44px}.counts{display:flex;gap:8px;flex-wrap:wrap;list-style:none;padding:0}.counts li{border:1px solid #526079;padding:8px;border-radius:10px}.plan textarea{width:100%;min-height:180px;resize:vertical;background:#152338;border:1px solid #8192aa;border-radius:8px;color:inherit;padding:12px;font:inherit}button{min-height:44px;padding:10px 16px;margin-top:12px;background:#18364a;color:inherit;border:1px solid #8192aa;border-radius:8px;font:inherit;cursor:pointer}button:disabled{opacity:.6}[hidden]{display:none!important}
