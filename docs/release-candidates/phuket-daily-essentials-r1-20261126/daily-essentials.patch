+(()=>{"use strict";const controls=Array.from(document.querySelectorAll("[data-errand]"));const panel=document.getElementById("plan");const note=document.getElementById("plan-text");const reset=document.getElementById("reset");const empty=panel.dataset.empty;const labels=[...panel.querySelectorAll("[data-count-label]")].map(e=>e.textContent);function update(){const groups=[[],[],[],[]];for(const e of controls){const i=Number(e.value);if(Number.isInteger(i)&&i>=0&&i<=3)groups[i].push(document.getElementById(e.getAttribute("aria-labelledby")).textContent)}const chunks=[];for(let i=1;i<=3;i++){panel.querySelector("[data-count='"+i+"']").textContent=String(groups[i].length);if(groups[i].length)chunks.push(labels[i-1]+":\n"+groups[i].map(s=>"• "+s).join("\n"))}note.value=chunks.join("\n\n")||empty;reset.disabled=groups[0].length===controls.length}for(const e of controls)e.addEventListener("change",update);reset.addEventListener("click",()=>{for(const e of controls)e.value="0";update()});panel.hidden=false;update()})();
