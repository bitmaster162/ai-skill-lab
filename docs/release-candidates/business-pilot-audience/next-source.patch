diff --git a/lib/start-audience.ts b/lib/start-audience.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bbbbb0753b1252967a892186287cdbeaf89bd30f
--- /dev/null
+++ b/lib/start-audience.ts
@@ -0,0 +1,11 @@
+export function isBusinessStart(pathname: string | null, params: Pick<URLSearchParams, "getAll"> | null): boolean {
+  if (pathname !== "/start" && pathname !== "/en/start") return false;
+  const values = params?.getAll("audience");
+  return values?.length === 1 && values[0] === "business";
+}
+
+export function businessApplicationHref(locale: "ru" | "en", diagnostic = false): string {
+  const prefix = locale === "en" ? "/en" : "";
+  const query = diagnostic ? "program=diagnostic&audience=business" : "audience=business";
+  return `${prefix}/start?${query}#application-form`;
+}
