+(()=>{"use strict";const fields=[...document.querySelectorAll("[data-amount]")],box=document.getElementById("results"),reset=document.getElementById("reset"),status=document.getElementById("status"),fmt=new Intl.NumberFormat(document.documentElement.lang,{minimumFractionDigits:2,maximumFractionDigits:2});const output=(id,value)=>{document.getElementById(id).textContent=value};const money=n=>fmt.format(n/100)+" THB";function parse(e){const s=e.value.trim();if(s===""){e.removeAttribute("aria-invalid");return {kind:"unknown"}}if(!/^\d{1,8}(?:[.,]\d{1,2})?$/.test(s)){e.setAttribute("aria-invalid","true");return {kind:"invalid"}}const [a,b=""]=s.replace(",",".").split(".");const n=Number(a)*100+Number((b+"00").slice(0,2));if(!Number.isSafeInteger(n)||n>1000000000){e.setAttribute("aria-invalid","true");return {kind:"invalid"}}e.removeAttribute("aria-invalid");return {kind:"valid",value:n}}function update(){const parsed=fields.map(parse),items=parsed.slice(1),valid=items.filter(x=>x.kind==="valid"),missing=items.filter(x=>x.kind==="unknown").length,bad=parsed.filter(x=>x.kind==="invalid").length,total=valid.reduce((a,b)=>a+b.value,0);output("known",valid.length?money(total):"—");output("unknown",String(missing));output("invalid",String(bad));const complete=parsed.every(x=>x.kind==="valid");const rem=complete?parsed[0].value-total:null;output("remaining",complete?money(rem):"—");status.textContent=bad?box.dataset.bad:!complete?box.dataset.incomplete:rem<0?box.dataset.over:box.dataset.ok;reset.disabled=fields.every(e=>e.value==="")}for(const e of fields)e.addEventListener("input",update);reset.addEventListener("click",()=>{for(const e of fields)e.value="";update();fields[0].focus()});box.hidden=false;update()})();
