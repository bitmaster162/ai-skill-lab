+*{box-sizing:border-box;min-width:0}body{margin:0;background:#070a12;color:#eef2f6;font:1rem/1.55 system-ui,sans-serif}header,main{max-width:920px;margin:auto;padding:20px clamp(16px,4vw,32px)}header{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}a{color:#8ef5df;text-decoration:underline;overflow-wrap:anywhere}h1,h2{line-height:1.2;overflow-wrap:anywhere}h1{font-size:clamp(1.8rem,5vw,3rem)}.muted{color:#b4bfce}.skip-link{position:fixed;left:-10000px;top:12px;z-index:1000;background:#b9ff3f;color:#070a12;padding:12px;max-width:calc(100% - 24px)}.skip-link:focus{left:12px}:is(a,input,button,main):focus-visible{outline:3px solid #b9ff3f;outline-offset:3px}fieldset{padding:16px;border:1px solid #61728a;border-radius:16px;margin:24px 0}legend{font-weight:700}.grid,.result{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:14px}.field{display:grid;gap:8px}.field:first-child{grid-column:1/-1}input{width:100%;font:inherit;color:inherit;background:#152338;border:1px solid #8192aa;border-radius:8px;min-height:44px;padding:10px}input[aria-invalid=true]{border:2px solid #f8aa96}output{display:block;font-size:1.4rem;font-weight:700;color:#8ef5df;overflow-wrap:anywhere}.result>div{padding:16px;border:1px solid #61728a;border-radius:12px;background:#0d1320}button{min-height:44px;padding:10px 16px;background:#18364a;color:inherit;border:1px solid #8192aa;border-radius:8px;font:inherit;cursor:pointer}button:disabled{opacity:.6}[hidden]{display:none!important}
diff --git a/public/phuket-daily-assets/budget.js b/public/phuket-daily-assets/budget.js
new file mode 100644
index 0000000..b013ebf83a041ea8ee602b68af1623566057e1d2
--- /dev/null
+++ b/public/phuket-daily-assets/budget.js
@@ -0,0 +1 @@
+(()=>{"use strict";const fields=[...document.querySelectorAll("[data-amount]")],box=document.getElementById("results"),reset=document.getElementById("reset"),status=document.getElementById("status"),fmt=new Intl.NumberFormat(document.documentElement.lang,{minimumFractionDigits:2,maximumFractionDigits:2});const output=(id,value)=>{document.getElementById(id).textContent=value};const money=n=>fmt.format(n/100)+" THB";function parse(e){const s=e.value.trim();if(s===""){e.removeAttribute("aria-invalid");return {kind:"unknown"}}if(!/^\d{1,8}(?:[.,]\d{1,2})?$/.test(s)){e.setAttribute("aria-invalid","true");return {kind:"invalid"}}const [a,b=""]=s.replace(",",".").split(".");const n=Number(a)*100+Number((b+"00").slice(0,2));if(!Number.isSafeInteger(n)||n>1000000000){e.setAttribute("aria-invalid","true");return {kind:"invalid"}}e.removeAttribute("aria-invalid");return {kind:"valid",value:n}}function update(){const parsed=fields.map(parse),items=parsed.slice(1),valid=items.filter(x=>x.kind==="valid"),missing=items.filter(x=>x.kind==="unknown").length,bad=parsed.filter(x=>x.kind==="invalid").length,total=valid.reduce((a,b)=>a+b.value,0);output("known",valid.length?money(total):"—");output("unknown",String(missing));output("invalid",String(bad));const complete=parsed.every(x=>x.kind==="valid");const rem=complete?parsed[0].value-total:null;output("remaining",complete?money(rem):"—");status.textContent=bad?box.dataset.bad:!complete?box.dataset.incomplete:rem<0?box.dataset.over:box.dataset.ok;reset.disabled=fields.every(e=>e.value==="")}for(const e of fields)e.addEventListener("input",update);reset.addEventListener("click",()=>{for(const e of fields)e.value="";update();fields[0].focus()});box.hidden=false;update()})();
