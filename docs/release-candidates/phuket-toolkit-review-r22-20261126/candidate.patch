+(()=>{"use strict";const g=id=>document.getElementById(id),t=JSON.parse(g('copy').textContent),fields=['deposit','deductions','received'].map(g),out=g('expected'),delta=g('delta'),status=g('status'),nf=new Intl.NumberFormat(document.documentElement.lang==='ru'?'ru-RU':'en-US');function amount(el){const s=el.value,n=Number(s),blank=s===''&&!el.validity.badInput,ok=/^[0-9]+$/.test(s)&&Number.isSafeInteger(n)&&n>=0&&n<=1000000000;el.setAttribute('aria-invalid',String(!blank&&!ok));return blank?{kind:'unknown'}:ok?{kind:'known',n}:{kind:'invalid'};}function clear(msg){out.textContent='—';delta.textContent='—';status.textContent=msg;}function render(){const values=fields.map(amount);if(values.some(v=>v.kind==='invalid')){clear(t.invalid);return;}if(values.some(v=>v.kind==='unknown')){clear(t.unknown);return;}const [d,c,r]=values.map(v=>v.n);if(c>d){clear(t.excess);return;}const expected=d-c,diff=expected-r;out.textContent=nf.format(expected)+' THB';delta.textContent=nf.format(diff)+' THB';status.textContent=diff>0?t.less:diff<0?t.more:t.equal;}fields.forEach(x=>x.addEventListener('input',render));g('example').addEventListener('click',()=>{[40000,5000,30000].forEach((n,i)=>{fields[i].value=String(n);});render();});g('reset').addEventListener('click',()=>{fields.forEach(x=>{x.value='';});render();fields[0].focus();});render();})();
