+export const dynamic = "force-static";
+export function GET(): Response {
+  return new Response("<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"robots\" content=\"noindex,nofollow\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src &#x27;none&#x27;; script-src &#x27;sha256-F8c4FUkEODFSzThS2sd8K9EdzRb1kzGDJgGt485wgOk=&#x27;; style-src &#x27;self&#x27;; connect-src &#x27;none&#x27;; form-action &#x27;none&#x27;; base-uri &#x27;none&#x27;; object-src &#x27;none&#x27;\"><title>Калькулятор аренды на Пхукете</title><link rel=\"stylesheet\" href=\"/phuket-rental-assets/rental-budget-calculator.css\" integrity=\"sha256-1AkubXbgu3OiOSnFI0hNr4T5w9Kh1AgYhidErl9xnMs=\"></head><body><a class=\"rental-skip-link\" href=\"#main\">К основному содержимому</a><main id=\"main\" tabindex=\"-1\"><h1>Калькулятор аренды на Пхукете</h1><p>Посчитайте расходы в месяц и деньги к заселению. Все суммы — в тайских батах. Вводите свои условия, включая ноль, если расход отсутствует.</p><fieldset><legend>THB</legend><div class=\"fields\"><div class=\"field\"><label for=\"rent\">Аренда за месяц (THB)</label><input id=\"rent\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"1000000000\" step=\"1\" autocomplete=\"off\" aria-describedby=\"status\"></div><div class=\"field\"><label for=\"utilities\">Услуги за месяц (THB)</label><input id=\"utilities\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"1000000000\" step=\"1\" autocomplete=\"off\" aria-describedby=\"status\"></div><div class=\"field\"><label for=\"deposit\">Возвратный депозит (THB)</label><input id=\"deposit\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"1000000000\" step=\"1\" autocomplete=\"off\" aria-describedby=\"status\"></div><div class=\"field\"><label for=\"oneoff\">Разовые платежи (THB)</label><input id=\"oneoff\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"1000000000\" step=\"1\" autocomplete=\"off\" aria-describedby=\"status\"></div></div><label class=\"toggle\"><input id=\"prepay\" type=\"checkbox\"> Услуги за первый месяц оплачиваются до заселения</label><button id=\"example\" type=\"button\">Вымышленный пример</button><button id=\"reset\" type=\"button\">Очистить</button></fieldset><div class=\"results\" aria-live=\"polite\"><div><strong>Всего в месяц</strong><output id=\"monthly\">—</output></div><div><strong>Деньги к заселению</strong><output id=\"upfront\">—</output></div></div><p id=\"status\" role=\"status\" data-invalid=\"Введите четыре целых суммы от 0 до 1 000 000 000 ฿. Пустое поле не считается нулём.\" data-ready=\"Расчёт готов.\">Введите четыре целых суммы от 0 до 1 000 000 000 ฿. Пустое поле не считается нулём.</p><p>Депозит входит только в сумму к заселению, а не в ежемесячный расход. Расчёт предполагает оплату одного месяца аренды при заселении. Другие сроки платежей уточните в договоре.</p><small>Локальный черновик. Данные не отправляются и не сохраняются этим инструментом. Браузер может восстановить значения. Это не объявление, бронь или подтверждение цены.</small><nav class=\"tool-nav\" aria-label=\"Инструменты арендатора\"><p>Значения между страницами не переносятся. При необходимости запишите нужные суммы для себя перед переходом.</p><ul role=\"list\"><li><a href=\"/phuket-universe/rental-shortlist\">Личная подборка жилья</a></li><li><a href=\"/phuket-universe/rental-journey\">К маршруту арендатора</a></li><li><a href=\"/en/phuket-universe/rental-budget-calculator\" lang=\"en\">English</a></li></ul></nav></main><script src=\"/phuket-rental-assets/rental-budget-calculator-1.js\" integrity=\"sha256-F8c4FUkEODFSzThS2sd8K9EdzRb1kzGDJgGt485wgOk=\"></script></body></html>\n", { status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Content-Security-Policy": "default-src 'none'; script-src 'sha256-F8c4FUkEODFSzThS2sd8K9EdzRb1kzGDJgGt485wgOk='; style-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; worker-src 'none'", "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "no-referrer", "Permissions-Policy": "camera=(), microphone=(), geolocation=()"} });
+}
