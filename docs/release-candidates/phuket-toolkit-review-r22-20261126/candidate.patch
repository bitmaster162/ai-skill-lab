+(()=>{"use strict";const ids=['rent','utilities','deposit','oneoff'];const fields=ids.map(id=>document.getElementById(id));const pre=document.getElementById('prepay');const monthly=document.getElementById('monthly');const upfront=document.getElementById('upfront');const status=document.getElementById('status');const nf=new Intl.NumberFormat(document.documentElement.lang==='ru'?'ru-RU':'en-US');const format=n=>nf.format(n)+' ฿';function render(){const vals=fields.map(x=>{const s=x.value;const n=Number(s);const ok=/^[0-9]+$/.test(s)&&Number.isSafeInteger(n)&&n>=0&&n<=1000000000;x.setAttribute('aria-invalid',ok?'false':'true');return ok?n:null;});if(vals.includes(null)){monthly.textContent='—';upfront.textContent='—';status.textContent=status.dataset.invalid;return;}const [r,u,d,o]=vals;monthly.textContent=format(r+u);upfront.textContent=format(r+d+o+(pre.checked?u:0));status.textContent=status.dataset.ready;}fields.forEach(x=>x.addEventListener('input',render));pre.addEventListener('change',render);document.getElementById('example').addEventListener('click',()=>{[28000,3000,56000,2000].forEach((n,i)=>{fields[i].value=String(n);});pre.checked=false;render();});document.getElementById('reset').addEventListener('click',()=>{fields.forEach(x=>{x.value='';});pre.checked=false;render();fields[0].focus();});render();})();
