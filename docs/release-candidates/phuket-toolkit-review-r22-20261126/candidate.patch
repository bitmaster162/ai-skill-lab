+(()=>{"use strict";const g=id=>document.getElementById(id),t=JSON.parse(g('copy').textContent),n=JSON.parse(g('note-copy').textContent),out=g('note-output'),status=g('note-status'),select=g('note-select');const fields=[...document.querySelectorAll('input,select')];const nf=new Intl.NumberFormat(document.documentElement.lang==='ru'?'ru-RU':'en-US');const clean=s=>s.replace(/[\u0000-\u001f\u007f-\u009f\u2028\u2029\u202a-\u202e\u2066-\u2069]/g,' ').trim().replace(/\s+/g,' ');const value=s=>clean(s)||t.unknown;function amount(el){const s=el.value,k=Number(s);if(s===''&&!el.validity.badInput)return{valid:true,text:t.unknown};return /^[0-9]+$/.test(s)&&Number.isSafeInteger(k)&&k>=0&&k<=1000000000?{valid:true,text:nf.format(k)+' THB'}:{valid:false};}function term(el){return el.options[el.selectedIndex].textContent;}function clear(msg){out.value='';select.disabled=true;status.textContent=msg;}function invalidate(){if(out.value)clear(n.stale);}function generate(){const ids=[1,2,3].filter(i=>g('keep'+i).checked&&!g('keep'+i).disabled);if(!ids.length){clear(n.empty);return;}const budget=amount(g('budget'));const rents=ids.map(i=>amount(g('rent'+i)));if(!budget.valid||rents.some(x=>!x.valid)){clear(n.invalid);return;}const lines=[n.heading,n.warning,'',t.budget+': '+budget.text,t.wanted+': '+term(g('wanted'))];ids.forEach((i,j)=>{lines.push('',t.option+' '+i,t.alias+': '+value(g('alias'+i).value),t.area+': '+value(g('area'+i).value),t.rent+': '+rents[j].text,t.term+': '+term(g('term'+i)),g('summary'+i).textContent,g('budgetResult'+i).textContent,g('termResult'+i).textContent,g('sourceResult'+i).textContent);});out.value=lines.join('\n');select.disabled=false;status.textContent=n.ready;}fields.forEach(x=>{x.addEventListener('input',invalidate);x.addEventListener('change',invalidate);});g('example').addEventListener('click',()=>clear(n.initial));g('reset').addEventListener('click',()=>clear(n.initial));g('note-generate').addEventListener('click',generate);select.addEventListener