+(()=>{"use strict";const t=JSON.parse(document.getElementById('copy').textContent);const g=id=>document.getElementById(id);const cards=[...document.querySelectorAll('[data-option]')];function amount(el){const s=el.value;const blank=s===''&&!el.validity.badInput;const n=Number(s);const valid=/^[0-9]+$/.test(s)&&Number.isSafeInteger(n)&&n>=0&&n<=1000000000;el.setAttribute('aria-invalid',String(!blank&&!valid));return blank?{state:'unknown'}:valid?{state:'known',n}:{state:'invalid'};}function render(){const budget=amount(g('budget')),desired=g('wanted').value;let count=0;for(const c of cards){const i=c.dataset.option;const v=k=>g(k+i);const rent=amount(v('rent')),term=v('term').value;const filled=Boolean(v('alias').value.trim()||v('area').value.trim()||rent.state!=='unknown'||term!=='unknown'||v('source').checked);const keep=v('keep');keep.disabled=!filled;if(!filled)keep.checked=false;if(keep.checked)count++;let bs='unknown',ts='unknown';if(rent.state==='invalid'||budget.state==='invalid')bs='invalid';else if(rent.state==='known'&&budget.state==='known')bs=rent.n<=budget.n?'fit':'miss';if(desired==='any')ts='any';else if(term!=='unknown')ts=term===desired?'fit':'miss';v('budgetResult').textContent=({fit:t.budgetFit,miss:t.budgetMiss,unknown:t.budgetUnknown,invalid:t.invalid})[bs];v('termResult').textContent=({fit:t.termFit,miss:t.termMiss,unknown:t.termUnknown,any:t.termAny})[ts];v('sourceResult').textContent=v('source').checked?t.checked:t.unchecked;v('summary').textContent=!filled?t.empty:bs==='invalid'?t.invalid:bs==='miss'||ts==='miss'?t.mismatch:bs==='fit'&&(ts==='fit'||ts==='any')?t.matched:t.incomplete;}g('count').textContent=t.count+' '+count+' / 3';}document.querySelectorAll('input,select').forEach(x=>{x.addEventListener('input',render);x.addEventListener('change',render);});function clear(){document.querySelectorAll('input').forEach(x=>{if(x.type==='checkbox')x.checked=false;else x.value='';});g('wanted').value='any';cards.forEach(c=>g('term'+c.dataset.opti