+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta http-equiv="Content-Security-Policy" content="default-src &#x27;none&#x27;; script-src &#x27;sha256-RBMLiH37CvpNJaik4OziPoKSxxSY1sBv2TuVwrK9e1Q=&#x27; &#x27;sha256-lX9Lrc/cXrWHr2Mbz4U7atKz7s0zh3qV4OsDHPsAbgI=&#x27;; style-src &#x27;self&#x27;; connect-src &#x27;none&#x27;; form-action &#x27;none&#x27;; base-uri &#x27;none&#x27;; object-src &#x27;none&#x27;"><title>Personal rental shortlist</title><link rel="stylesheet" href="/phuket-rental-assets/rental-shortlist.css" integrity="sha256-QGreaFczc7OJgOnBsZrcfcw96Xxfi4a/sDQ7nL0GAuI="></head><body><a class="rental-skip-link" href="#main">Skip to main content</a><main id="main" tabindex="-1"><h1>Personal rental shortlist</h1><p>Compare up to three options you found. Enter a nickname, area, monthly rent and term. These are your notes, not Phuket Universe inventory.</p><fieldset><legend>THB</legend><div class="grid"><label class="field" for="budget"><span>Maximum monthly rent, THB (excluding additional costs)</span><input id="budget" type="number" inputmode="numeric" min="0" max="1000000000" step="1" autocomplete="off"></label><label class="field" for="wanted"><span>Preferred term</span><select id="wanted"><option value="any">Any</option><option value="6">6 months</option><option value="12">12 months</option></select></label></div><button id="example" type="button">Fictional example</button><button id="reset" type="button">Clear all</button></fieldset><p id="count" role="status">Marked for personal shortlist: 0 / 3</p><div class="grid"><fieldset data-option="1"><legend>Option 1</legend><div class="fields"><label class="field" for="alias1"><span>Nickname</span><input id="alias1" type="text" maxlength="50" autocomplete="off"></label><label class="field" for="area1"><span>Area</span><input id="area1" type="text" maxlength="50" autocomplete="off"></label><label class="field" for="rent1"><span>Monthly rent, THB</span><input id="rent1" type="number" inputmode="numeric" min="0" max="1000000000" step="1" autocomplete="off"></label><label class="field" for="term1"><span>Advertised term</span><select id="term1"><option value="unknown">Unknown</option><option value="6">6 months</option><option value="12">12 months</option><option value="other">Other term</option></select></label><label class="toggle"><input id="source1" type="checkbox">I checked the source link</label><label class="toggle"><input id="keep1" type="checkbox" disabled>Keep in personal shortlist</label></div><div class="result" aria-live="polite"><strong id="summary1">Option not filled in.</strong><p id="budgetResult1"></p><p id="termResult1"></p><p id="sourceResult1"></p></div></fieldset><fieldset data-option="2"><legend>Option 2</legend><div class="fields"><label class="field" for="alias2"><span>Nickname</span><input id="alias2" type="text" maxlength="50" autocomplete="off"></label><label class="field" for="area2"><span>Area</span><input id="area2" type="text" maxlength="50" autocomplete="off"></label><label class="field" for="rent2"><span>Monthly rent, THB</span><input id="rent2" type="number" inputmode="numeric" min="0" max="1000000000" step="1" autocomplete="off"></label><label class="field" for="term2"><span>Advertised term</span><select id="term2"><option value="unknown">Unknown</option><option value="6">6 months</option><option value="12">12 months</option><option value="other">Other term</option></select></label><label class="toggle"><input id="source2" type="checkbox">I checked the source link</label><label class="toggle"><input id="keep2" type="checkbox" disabled>Keep in personal shortlist</label></div><div class="result" aria-live="polite"><strong id="summary2">Option not filled in.</strong><p id="budgetResult2"></p><p id="termResult2"></p><p id="sourceResult2"></p></div></fieldset><fieldset data-option="3"><legend>Option 3</legend><div class=