+export const dynamic = "force-static";
+export function GET(): Response {
+  return new Response("<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex,nofollow\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src &#x27;none&#x27;; script-src &#x27;sha256-J3GeqCmOdDuDs0Wpclkx9LRbPk8Uz0JjtBQJ0Du57xA=&#x27;; style-src &#x27;self&#x27;; connect-src &#x27;none&#x27;; form-action &#x27;none&#x27;; base-uri &#x27;none&#x27;; object-src &#x27;none&#x27;\"><title>Чек-лист заселения</title><link rel=\"stylesheet\" href=\"/phuket-rental-assets/rental-move-in.css\" integrity=\"sha256-TEYJH0BdDJ9dxeoWUe3bPmaOcNrA2sstgld8jih4/FM=\"></head><body><a class=\"rental-skip-link\" href=\"#main\">К основному содержимому</a><header class=\"rental-nav-header\"><nav><a href=\"/phuket-universe/rental-journey\">К маршруту арендатора</a><a href=\"/en/phuket-universe/rental-move-in\" lang=\"en\">English</a></nav></header><main id=\"main\" tabindex=\"-1\"><h1>Чек-лист заселения</h1><p>Отмечайте состояние каждого пункта при передаче жилья. «Зафиксировано» означает только, что вы записали результат проверки, а не что всё исправно или согласовано.</p><p>Личные отметки не являются актом приёма-передачи, подтверждением безопасности или юридическим заключением. Не вводите здесь адреса, имена, контакты или данные документов.</p><h2>Состояния пунктов</h2><ul class=\"counts\" role=\"status\" aria-live=\"polite\"><li>Не проверено: <strong data-count=\"0\">8</strong></li><li>Зафиксировано: <strong data-count=\"1\">0</strong></li><li>Нужно уточнить: <strong data-count=\"2\">0</strong></li><li>Не применимо: <strong data-count=\"3\">0</strong></li></ul><ol class=\"items\" role=\"list\"><li><h3 id=\"item-1-label\">Ключи и доступ</h3><p id=\"item-1-hint\">Сверьте количество переданных ключей, карт доступа и пультов. Проверьте обычный вход и выход без вмешательства в замки.</p><select id=\"item-1\" aria-labelledby=\"item-1-label\" aria-describedby=\"item-1-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li><li><h3 id=\"item-2-label\">Состояние помещений</h3><p id=\"item-2-hint\">Запишите уже существующие повреждения, пятна и следы протечек. При необходимости отдельно сделайте разрешённые фотографии.</p><select id=\"item-2\" aria-labelledby=\"item-2-label\" aria-describedby=\"item-2-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li><li><h3 id=\"item-3-label\">Опись имущества</h3><p id=\"item-3-hint\">Сверьте переданные предметы и их состояние с согласованным списком.</p><select id=\"item-3\" aria-labelledby=\"item-3-label\" aria-describedby=\"item-3-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li><li><h3 id=\"item-4-label\">Счётчики и услуги</h3><p id=\"item-4-hint\">Запишите доступные показания воды и электричества, дату и порядок оплаты. Не вскрывайте оборудование и электрощит.</p><select id=\"item-4\" aria-labelledby=\"item-4-label\" aria-describedby=\"item-4-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li><li><h3 id=\"item-5-label\">Связь и бытовые приборы</h3><p id=\"item-5-hint\">Уточните подключение интернета и обычную работу доступных приборов. Не выполняйте опасных проверок.</p><select id=\"item-5\" aria-labelledby=\"item-5-label\" aria-describedby=\"item-5-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li><li><h3 id=\"item-6-label\">Переданные документы</h3><p id=\"item-6-hint\">Сверьте экземпляры согласованных документов и подтверждения уже совершённых платежей. Не отмечайте неполученное как полученное.</p><select id=\"item-6\" aria-labelledby=\"item-6-label\" aria-describedby=\"item-6-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li><li><h3 id=\"item-7-label\">Порядок сообщения о дефектах</h3><p id=\"item-7-hint\">Уточните, кому и каким способом сообщать о неисправностях, и как фиксировать ответ.</p><select id=\"item-7\" aria-labelledby=\"item-7-label\" aria-describedby=\"item-7-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li><li><h3 id=\"item-8-label\">Условия возврата жилья</h3><p id=\"item-8-hint\">Запишите согласованный порядок возврата ключей, осмотра и расчётов при выезде. Не подменяйте договор этим списком.</p><select id=\"item-8\" aria-labelledby=\"item-8-label\" aria-describedby=\"item-8-hint\" autocomplete=\"off\"><option value=\"0\">Не проверено</option><option value=\"1\">Зафиксировано</option><option value=\"2\">Нужно уточнить</option><option value=\"3\">Не применимо</option></select></li></ol><p><button type=\"button\" id=\"reset\">Сбросить все отметки</button></p><small>Черновик для локального просмотра: инструмент не сохраняет и не отправляет отметки. Браузер может восстановить значения. Перед уходом запишите важные результаты отдельно.</small></main><script src=\"/phuket-rental-assets/rental-move-in-1.js\" integrity=\"sha256-J3GeqCmOdDuDs0Wpclkx9LRbPk8Uz0JjtBQJ0Du57xA=\"></script></body></html>\n", { status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Content-Security-Policy": "default-src 'none'; script-src 'sha256-J3GeqCmOdDuDs0Wpclkx9LRbPk8Uz0JjtBQJ0Du57xA='; style-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; worker-src 'none'", "X-Robots-Tag": "noindex, nofollow", "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "no-referrer", "Permissions-Policy": "camera=(), microphone=(), geolocation=()"} });
