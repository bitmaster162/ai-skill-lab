diff --git a/components/phuketRentalJourney.ts b/components/phuketRentalJourney.ts
new file mode 100644
index 0000000..3a0d337b871cd996b49a285c9ead432160ff19d2
--- /dev/null
+++ b/components/phuketRentalJourney.ts
@@ -0,0 +1,16 @@
+export type RentalJourneyLocale = "ru" | "en";
+const gateways = {"ru": "<div class=\"pu-s098\" id=\"rental-journey-entry\"><p class=\"pu-s095\">План поиска, сравнение районов, расходы и вопросы перед просмотром.</p><a class=\"pu-s082\" href=\"/phuket-universe/rental-journey\">Маршрут арендатора</a></div>", "en": "<div class=\"pu-s098\" id=\"rental-journey-entry\"><p class=\"pu-s095\">Search plan, area comparison, costs and viewing questions.</p><a class=\"pu-s082\" href=\"/en/phuket-universe/rental-journey\">Rental journey</a></div>"} as const;
+const tails = {"ru": "<p class=\"pu-s095\">Показываем только объекты агентств, которые дали согласие, и только с прямой ссылкой на их сайт. Фото и описания остаются у агентства. Цену и наличие проверяйте по ссылке.</p>\n</div>\n</section>", "en": "<p class=\"pu-s095\">Only properties with agency permission and a direct link to the source can appear here. Photos and descriptions stay with the agency. Check availability and prices at the source.</p>\n</div>\n</section>"} as const;
+export function withRentalJourney(markup: string, locale: RentalJourneyLocale): string {
+  if (locale !== "ru" && locale !== "en") throw new Error("Unknown rental locale");
+  const marker = 'id="homes"';
+  if (markup.split(marker).length !== 2 || markup.includes('id="rental-journey-entry"')) throw new Error("Rental gateway boundary");
+  const start = markup.indexOf(marker);
+  const end = markup.indexOf("</section>", start) + "</section>".length;
+  const tail = tails[locale];
+  const i = markup.indexOf(tail, start);
+  if (end < start || i < start || i + tail.length !== end || markup.split(tail).length !== 2) throw new Error("Rental section drift");
+  const next = tail.replace("\n</div>\n</section>", "\n" + gateways[locale] + "\n</div>\n</section>");
+  if (next === tail) throw new Error("Rental insertion drift");
+  return markup.slice(0, i) + next + markup.slice(i + tail.length);
+}
