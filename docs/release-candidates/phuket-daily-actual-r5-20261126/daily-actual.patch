id="food" data-amount="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="food-actual">Продукты и покупки — Фактически потрачено</label><input id="food-actual" data-actual="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="food-state">Продукты и покупки — Статус дела</label><select id="food-state" data-errand-state=""><option value="0">Не выбрано</option><option value="1">Сегодня</option><option value="2">Позже</option><option value="3">Выполнено</option></select></div><div class="field"><label for="laundry">Стирка и бытовые дела — План</label><input id="laundry" data-amount="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="laundry-actual">Стирка и бытовые дела — Фактически потрачено</label><input id="laundry-actual" data-actual="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="laundry-state">Стирка и бытовые дела — Статус дела</label><select id="laundry-state" data-errand-state=""><option value="0">Не выбрано</option><option value="1">Сегодня</option><option value="2">Позже</option><option value="3">Выполнено</option></select></div><div class="field"><label for="work">Работа и интернет — План</label><input id="work" data-amount="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="work-actual">Работа и интернет — Фактически потрачено</label><input id="work-actual" data-actual="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="work-state">Работа и интернет — Статус дела</label><select id="work-state" data-errand-state=""><option value="0">Не выбрано</option><option value="1">Сегодня</option><option value="2">Позже</option><option value="3">Выполнено</option></select></div><div class="field"><label for="transport">Транспорт — План</label><input 