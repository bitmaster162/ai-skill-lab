d</label><input id="transport" data-amount="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="transport-actual">Transport — Actually spent</label><input id="transport-actual" data-actual="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="transport-state">Transport — Errand status</label><select id="transport-state" data-errand-state=""><option value="0">Not selected</option><option value="1">Today</option><option value="2">Later</option><option value="3">Done</option></select></div><div class="field"><label for="services">Local services — Planned</label><input id="services" data-amount="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="services-actual">Local services — Actually spent</label><input id="services-actual" data-actual="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="services-state">Local services — Errand status</label><select id="services-state" data-errand-state=""><option value="0">Not selected</option><option value="1">Today</option><option value="2">Later</option><option value="3">Done</option></select></div><div class="field"><label for="leisure">Leisure and a walk — Planned</label><input id="leisure" data-amount="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="leisure-actual">Leisure and a walk — Actually spent</label><input id="leisure-actual" data-actual="" type="text" inputmode="decimal" autocomplete="off" maxlength="11" aria-describedby="units"><label for="leisure-state">Leisure and a walk — Errand status</label><select id="leisure-state" data-errand-state=""><option value="0">Not selected</option><option value="1">Today</option><option value="2">Later</option><option value="3">Done</option></select></div></div></fieldset><section id="results" hidden data-incomplete="Balance not calculated: fill the limit and all six categories." data-bad="Correct the invalid amounts." data-ok="The plan is within your limit." data-over="The plan exceeds your limit." aria-labelledby="results-title"><h2 id="results-title">Calculation</h2><div class="result" aria-live="polite"><div><span>Known planned expenses</span><output id="known">—</output></div><div><span>Categories without amounts</span><output id="unknown">—</output></div><div><span>Invalid fields</span><output id="invalid">—</output></div><div><span>Remaining planned limit</span><output id="remaining">—</output></div></div><p id="status" role="status"></p><section id="actual-results" aria-labelledby="actual-title" data-title="Actual daily spending" data-known="Known actual expenses" data-remaining="Remaining after actual spending" data-delta="Actual minus planned"><h2 id="actual-title">Actual daily spending</h2><div class="result" aria-live="polite"><div><span>Known actual expenses</span><output id="actual-known">—</output></div><div><span>Unknown actual amounts</span><output id="actual-missing">—</output></div><div><span>Invalid actual amounts</span><output id="actual-invalid">—</output></div><div><span>Remaining after actual spending</span><output id="actual-remaining">—</output></div><div><span>Actual minus planned</span><output id="actual-delta">—</output></div></div><p class="muted">Variance is calculated only when all six planned and actual amounts are valid. A positive value means spending exceeded the plan; a negative value means spending was below it.</p></section><div id="summary" class="summary" data-title="Personal daily summary" data-unknown="Unknown" data-invalid="Invalid amount" data-known="Known planned expenses" data-remaining="Remaining planned limit"><h2 id="summary-title">Personal daily summary</h2><p class="muted">Select and copy the text manually if you want to keep it. The app does not send or store the summary.</p><textarea id="summary-text" aria-labelledby="summary-title" readonly></textarea></div><button id="reset" type="button">Clear all amounts and choices</button></section><noscript><p>Without JavaScript, enter amounts and statuses manually; automatic summary is unavailable.</p></noscript><p class="muted">The app does not send or store amounts. Your browser may restore values when you return. Do not enter personal information.</p></main><script src="/phuket-daily-assets/budget.js" integrity="sha256-FyrZjZ65sicJZ3ZasCJ+LAhXP7QnIYTKET0wibzWLnc="></script></body></html>
